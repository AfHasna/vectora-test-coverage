# Which environment the run targets: prod (read-only) or staging (writes allowed).
TEST_ENV=prod

# The system under test. Production is read-only by rule: the request guard
# blocks writes there.
BASE_URL=https://admin.govectora.com

# Staging, where the data-changing cases will run. No default on purpose:
# a wrong guess here would point those cases at production.
STAGING_BASE_URL=

# Roles. Each one gets its own saved session under .auth/.
# Super Admin falls back to the ADMIN_* pair below, which the read-only cases use.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_OTP=

OPERATIONS_MANAGER_EMAIL=
OPERATIONS_MANAGER_PASSWORD=
OPERATIONS_MANAGER_OTP=

EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=
EMPLOYEE_OTP=

CUSTOM_ROLE_EMAIL=
CUSTOM_ROLE_PASSWORD=
CUSTOM_ROLE_OTP=

# The account the read-only cases have always used. Sign-in asks for a 6-digit
# SMS code, which goes in ADMIN_OTP.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_OTP=

# Optional: slow a headed run down so it can be followed on screen.
SLOWMO=

TESTDINO_PAT=
