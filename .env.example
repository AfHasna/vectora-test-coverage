# Which environment the run targets: prod (read-only) or staging (writes allowed).
TEST_ENV=prod

# Admin Portal
ADMIN_BASE_URL=https://admin.govectora.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_OTP=000000

# Client Portal — leave unset to use the default URL; do not set an empty value.
CLIENT_BASE_URL=https://portal.govectora.com
CLIENT_EMAIL=
CLIENT_PASSWORD=
CLIENT_OTP=000000

# Service Provider Portal
PROVIDER_BASE_URL=https://provider.govectora.com
SP_EMAIL=
SP_PASSWORD=
SP_OTP=000000

# Optional: slow a headed run so it can be followed on screen.
SLOWMO=
