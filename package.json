{
  "name": "vectora-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript regression suite for Vectora Admin, Client, Service Provider, Driver, and Guardian apps",
  "license": "ISC",
  "scripts": {
    "test": "node scripts/clean-allure-results.mjs && playwright test",
    "test:regression": "npx playwright test tests/regression --grep @regression",
    "test:archive": "npx playwright test --config=playwright.archive.config.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "list": "playwright test --list",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report:generate": "node scripts/report-generate.mjs",
    "report:open": "npx allure open --port 8083 allure-report/latest",
    "report:show": "playwright show-report reports/html",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "allure": "^3.16.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.0",
    "allure-playwright": "^3.4.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
