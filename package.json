{
  "name": "vectora-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation for the Vectora portals, page-object based",
  "license": "ISC",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:auth": "playwright test --project=auth",
    "test:backlog": "playwright test --project=backlog",
    "list": "playwright test --list",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report:show": "playwright show-report reports/html",
    "report:merge": "playwright merge-reports --reporter html,junit ./reports/blob",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --report-name \"Vectora Admin - Read-only E2E\"",
    "allure:open": "allure open reports/allure-report",
    "auth:login": "playwright codegen https://admin.govectora.com/sign-in --save-storage=.auth/prod.super-admin.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "allure": "^3.16.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.0",
    "allure-playwright": "^3.4.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
